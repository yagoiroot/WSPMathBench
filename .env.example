# Copy this file to `.env` in the repository root and fill it in. `.env` is ignored by git.
# wspmathbench/config.py reads it on both sides (Windows and Linux/WSL); a variable already set in
# the environment wins over the file. Lines are KEY=VALUE; leave a value empty to use the default.

# ---------------------------------------------------------------------------------------------
# API keys. None is needed for the self-test or for sessions with the stub provider.
# ---------------------------------------------------------------------------------------------
# OpenAI models (gpt-6.1-sol, gpt-6-astra, gpt-6-astra-pro). Also needed to SCORE a tiny model on
# GSM8K-500 or MATH-500: the grader calls a small OpenAI model for replies it cannot read by rule.
OPENAI_API_KEY=
# claude-fable-5-2
ANTHROPIC_API_KEY=
# Models reached through OpenRouter. The presets of gemini-4-carbon, deepseek-v4.1-flash-1017 and
# kimi-k3.1-pro use it.
OPENROUTER_API_KEY=
# Only when a model is called on its provider's own API instead of OpenRouter ("host": null):
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# ---------------------------------------------------------------------------------------------
# Machine settings
# ---------------------------------------------------------------------------------------------
# Folder holding the tiny models and the edited checkpoints (about 2 GB per checkpoint). On
# Windows give a Windows path on a local disk, for example C:\wspmathbench_models; the Linux side
# reads it as /mnt/c/... Set it here: the default is the home folder, which differs between
# Windows and WSL. Default: <home>/wspmathbench_models
WSPMB_MODELS_DIR=
# The Hugging Face cache that tools/prepare_tiny_models.py copies the models out of.
# Default: HF_HUB_CACHE if set, otherwise <home>/.cache/huggingface/hub
WSPMB_HF_CACHE_DIR=
# Where sessions, scores, figures and error logs are written. Default: <repository>/results
WSPMB_RESULTS_DIR=

# Linux-side paths (expanded by bash; ~ is the Linux home folder)
# The virtual environment with vLLM. Default: ~/venvs/vllm
WSPMB_VLLM_VENV=
# The Python that runs oneshot_code programs. Default: ~/venvs/wsp_sandbox/bin/python
WSPMB_SANDBOX_PYTHON=
# Folder for the tiny-model server's console logs. Default: ~/wspmathbench_server_logs
WSPMB_SERVER_LOG_DIR=
# Port of the tiny-model server. Default: 8000
WSPMB_SERVER_PORT=

# Limits of a oneshot_code program. The memory limit is quoted in the prompt, so changing it
# changes what the primary LLM is told. Defaults (the paper's values): 56 (GiB of memory) and
# 8 (CPU threads).
WSPMB_SANDBOX_MEM_GB=
WSPMB_SANDBOX_THREADS=
